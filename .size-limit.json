[
  {
    "name": "useIframe only",
    "path": "dist/index.js",
    "import": "{ useIframe }",
    "ignore": ["react", "react-dom"],
    "limit": "1.5 kB",
    "gzip": true
  },
  {
    "name": "useIframeResize only (incl. handshake/connection)",
    "path": "dist/index.js",
    "import": "{ useIframeResize }",
    "ignore": ["react", "react-dom"],
    "limit": "5 kB",
    "gzip": true
  },
  {
    "name": "<Frame> (portal, resize, copyStyles)",
    "path": "dist/index.js",
    "import": "{ Frame }",
    "ignore": ["react", "react-dom"],
    "limit": "6.75 kB",
    "gzip": true
  },
  {
    "name": "useIframeRPC + useIframeEvent",
    "path": "dist/index.js",
    "import": "{ useIframeRPC, useIframeEvent }",
    "ignore": ["react", "react-dom"],
    "limit": "6.5 kB",
    "gzip": true
  },
  {
    "name": "parent entry (everything)",
    "path": "dist/index.js",
    "import": "*",
    "ignore": ["react", "react-dom"],
    "limit": "10.5 kB",
    "gzip": true
  },
  {
    "name": "child entry (everything)",
    "path": "dist/child/index.js",
    "import": "*",
    "limit": "6.25 kB",
    "gzip": true
  },
  {
    "name": "child/react entry (useParent, useParentEvent)",
    "path": "dist/child/react.js",
    "import": "*",
    "ignore": ["react", "react-dom"],
    "limit": "7.25 kB",
    "gzip": true
  },
  {
    "name": "child IIFE (<script> build)",
    "path": "dist/child.global.js",
    "limit": "6.25 kB",
    "gzip": true
  }
]
