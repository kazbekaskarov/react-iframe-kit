[
  {
    "name": "useIframe only",
    "path": "dist/index.js",
    "import": "{ useIframe }",
    "ignore": ["react", "react-dom"],
    "limit": "1 kB",
    "gzip": true
  },
  {
    "name": "useIframeResize only",
    "path": "dist/index.js",
    "import": "{ useIframeResize }",
    "ignore": ["react", "react-dom"],
    "limit": "1.75 kB",
    "gzip": true
  },
  {
    "name": "<Frame> (portal, resize, copyStyles)",
    "path": "dist/index.js",
    "import": "{ Frame }",
    "ignore": ["react", "react-dom"],
    "limit": "3.5 kB",
    "gzip": true
  },
  {
    "name": "parent entry (everything)",
    "path": "dist/index.js",
    "import": "*",
    "ignore": ["react", "react-dom"],
    "limit": "5 kB",
    "gzip": true
  },
  {
    "name": "child entry (everything)",
    "path": "dist/child/index.js",
    "import": "*",
    "limit": "2 kB",
    "gzip": true
  },
  {
    "name": "child IIFE (<script> build)",
    "path": "dist/child.global.js",
    "limit": "2 kB",
    "gzip": true
  }
]
