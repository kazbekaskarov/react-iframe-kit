[
  {
    "name": "useIframe only",
    "path": "dist/index.js",
    "import": "{ useIframe }",
    "ignore": ["react", "react-dom"],
    "limit": "1 kB",
    "gzip": true
  },
  {
    "name": "useIframeResize only (incl. handshake/connection)",
    "path": "dist/index.js",
    "import": "{ useIframeResize }",
    "ignore": ["react", "react-dom"],
    "limit": "4.5 kB",
    "gzip": true
  },
  {
    "name": "<Frame> (portal, resize, copyStyles)",
    "path": "dist/index.js",
    "import": "{ Frame }",
    "ignore": ["react", "react-dom"],
    "limit": "6 kB",
    "gzip": true
  },
  {
    "name": "parent entry (everything, pre-RPC)",
    "path": "dist/index.js",
    "import": "*",
    "ignore": ["react", "react-dom"],
    "limit": "6.5 kB",
    "gzip": true
  },
  {
    "name": "child entry (everything, pre-RPC)",
    "path": "dist/child/index.js",
    "import": "*",
    "limit": "3.5 kB",
    "gzip": true
  },
  {
    "name": "child IIFE (<script> build, pre-RPC)",
    "path": "dist/child.global.js",
    "limit": "3.5 kB",
    "gzip": true
  }
]
